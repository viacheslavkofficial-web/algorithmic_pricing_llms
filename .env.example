OPENROUTER_API_KEY=<your-openrouter-api-key>
# OpenRouter model ID; pinned snapshot for reproducibility (not :free or :batch)
MODEL_NAME=z-ai/glm-5.3-flash-20260826
# Sampling temperature (0.7 = value used by Fish et al.)
TEMPERATURE=0.7
# Reasoning effort passed to OpenRouter as extra_body={"reasoning": {"effort": ...}}
REASONING_EFFORT=low
